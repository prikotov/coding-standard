#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadPath = dirname(__DIR__) . '/vendor/autoload.php';
if (!is_file($autoloadPath)) {
    $autoloadPath = $GLOBALS['_composer_autoload_path'] ?? getcwd() . '/vendor/autoload.php';
}
require $autoloadPath;

use PrikotovCodingStandard\Metrics\PhpantomAnalyzer;

$options = getopt('', ['project-root::', 'output::']);
$projectRoot = $options['project-root'] ?? getcwd();
$output = $options['output'] ?? 'var/metrics/phpantom.json';

try {
    if (!is_string($projectRoot) || !is_string($output)) {
        throw new InvalidArgumentException('Project root and output must be strings.');
    }
    $report = (new PhpantomAnalyzer())->analyze($projectRoot);
    if (!is_dir(dirname($output)) && !mkdir(dirname($output), 0777, true) && !is_dir(dirname($output))) {
        throw new RuntimeException('Cannot create PHPantom report directory.');
    }
    $json = json_encode(
        $report,
        JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR,
    );
    if (file_put_contents($output, $json . "\n") === false) {
        throw new RuntimeException("Cannot write PHPantom report: $output");
    }
    fwrite(STDOUT, "PHPantom report written to $output\n");
} catch (Throwable $exception) {
    fwrite(STDERR, "metrics-phpantom: {$exception->getMessage()}\n");
    exit(1);
}

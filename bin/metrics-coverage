#!/usr/bin/env bash
set -euo pipefail

if ! php -m | grep -qi '^pcov$'; then
    rm -f var/metrics/clover.xml
    printf 'metrics-coverage: PCOV is required to collect coverage\n' >&2
    exit 1
fi
mkdir -p var/metrics
exec php -d pcov.enabled=1 vendor/bin/phpunit \
    --coverage-clover var/metrics/clover.xml \
    --coverage-text=php://stdout \
    --only-summary-for-coverage-text \
    --no-progress

#!/usr/bin/env bash
set -euo pipefail

output=${1:-var/metrics/clover.xml}
configuration=${2:-}
suite=${3:-unit}

if ! php -m | grep -qi '^pcov$'; then
    rm -f "$output"
    printf 'metrics-coverage: PCOV is required to collect coverage\n' >&2
    exit 1
fi
if [[ ! -x vendor/bin/phpunit ]]; then
    printf 'metrics-coverage: PHPUnit is required at vendor/bin/phpunit\n' >&2
    exit 1
fi
mkdir -p "$(dirname "$output")"
arguments=()
if [[ -n "$configuration" ]]; then
    arguments+=(--configuration "$configuration")
fi
arguments+=(--testsuite "$suite")
set +e
php -d pcov.enabled=1 vendor/bin/phpunit "${arguments[@]}" \
    --coverage-clover "$output" \
    --coverage-text=php://stdout \
    --only-summary-for-coverage-text \
    --no-progress
code=$?
set -e
if [[ ! -s "$output" ]]; then
    printf 'metrics-coverage: PHPUnit did not produce Clover coverage\n' >&2
    exit "$code"
fi
if [[ "$code" -ne 0 ]]; then
    printf 'metrics-coverage: PHPUnit failed, using coverage from completed tests\n' >&2
fi

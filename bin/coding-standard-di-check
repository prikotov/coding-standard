#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * coding-standard-di-check — verify that non-service classes of the consumer
 * project are excluded from Symfony DI and never injected as constructor
 * dependencies.
 *
 * Usage:
 *   php vendor/bin/coding-standard-di-check [project-dir]
 *
 *   project-dir  — project root (default: current working directory).
 *
 * Checks (docs/conventions/modules/configuration.md):
 *   1. Every `services.yaml` resource import excludes non-service classes
 *      (`*Dto.php`, `*Event.php`, `*Exception.php`, `*Enum.php`, `*Vo.php`,
 *      Application `*Command.php` / `*Query.php`) with module-wide suffix
 *      patterns — listing individual files or single directories is rejected.
 *   2. No service injects a non-service class through its constructor.
 *
 * Exit codes: 0 — convention holds; 1 — problems found (see output).
 */

$autoloadPath = dirname(__DIR__) . '/vendor/autoload.php';
if (!is_file($autoloadPath)) {
    $autoloadPath = $GLOBALS['_composer_autoload_path'] ?? getcwd() . '/vendor/autoload.php';
}
require $autoloadPath;

use PrikotovCodingStandard\Di\NonServiceDiChecker;
use PrikotovCodingStandard\Verify\VerificationResult;

try {
    $arguments = array_slice($argv, 1);
    if (in_array('--help', $arguments, true) || in_array('-h', $arguments, true)) {
        fwrite(STDOUT, <<<'TEXT'
Usage: coding-standard-di-check [project-dir]

  project-dir  — project root (default: current working directory).

Checks:
  1. Module `services.yaml` resource imports exclude non-service classes
     (DTO, event, exception, enum, value object, Application command/query)
     with module-wide suffix patterns.
  2. No service injects a non-service class through its constructor.

TEXT);
        exit(0);
    }

    $projectDir = null;
    foreach ($arguments as $argument) {
        if (str_starts_with($argument, '--')) {
            throw new InvalidArgumentException('Unknown option: ' . $argument);
        }

        if ($projectDir === null) {
            $projectDir = $argument;
        } else {
            throw new InvalidArgumentException('Unexpected argument: ' . $argument);
        }
    }

    $projectDir = $projectDir !== null ? realpath($projectDir) : getcwd();
    if ($projectDir === false || !is_dir($projectDir)) {
        fwrite(STDERR, "coding-standard-di-check: project directory does not exist\n");
        exit(1);
    }

    $result = (new NonServiceDiChecker())->check($projectDir);
    fwrite(STDOUT, 'coding-standard-di-check: ' . $projectDir . PHP_EOL . PHP_EOL);
    foreach ($result->entries() as $entry) {
        fwrite(STDOUT, renderEntry($entry) . PHP_EOL);
    }

    fwrite(STDOUT, PHP_EOL);
    if ($result->hasFailed()) {
        fwrite(STDOUT, 'FAIL: non-service classes leak into Symfony DI — see above.' . PHP_EOL);
        exit(1);
    }
    fwrite(STDOUT, 'OK: non-service classes are excluded from Symfony DI.' . PHP_EOL);
} catch (Throwable $exception) {
    fwrite(STDERR, 'coding-standard-di-check: ' . $exception->getMessage() . PHP_EOL);
    exit(1);
}

/**
 * @param array{level: 'ok'|'warn'|'fail', message: string, hint: string|null} $entry
 */
function renderEntry(array $entry): string
{
    $marker = match ($entry['level']) {
        'ok' => '  [OK]  ',
        'warn' => '  [WARN]',
        'fail' => '  [FAIL]',
    };
    $rendered = $marker . ' ' . $entry['message'];
    if (($entry['hint'] ?? null) !== null) {
        foreach (explode("\n", (string) $entry['hint']) as $line) {
            $rendered .= PHP_EOL . '         ' . $line;
        }
    }

    return $rendered;
}

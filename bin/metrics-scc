#!/usr/bin/env bash
set -euo pipefail

output=${1:-var/metrics/scc.json}
if ! command -v scc >/dev/null 2>&1; then
    rm -f "$output" "$(dirname "$output")/scc-version.txt"
    printf 'metrics-scc: scc is required; install it with go install github.com/boyter/scc/v3@latest\n' >&2
    exit 1
fi
mkdir -p "$(dirname "$output")"
scc --format json --by-file --exclude-dir vendor --exclude-dir .git --exclude-dir var --output "$output" .
scc --version | awk '{print $NF}' > "$(dirname "$output")/scc-version.txt"
printf 'SCC report written to %s\n' "$output"

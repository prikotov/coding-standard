#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadPath = dirname(__DIR__) . '/vendor/autoload.php';
if (!is_file($autoloadPath)) {
    $autoloadPath = $GLOBALS['_composer_autoload_path'] ?? getcwd() . '/vendor/autoload.php';
}
require $autoloadPath;

use PrikotovCodingStandard\Metrics\MetricsReviewPipeline;

try {
    $options = [];
    foreach (array_slice($argv, 1) as $argument) {
        if ($argument === '--help') {
            fwrite(STDOUT, <<<'TEXT'
Usage: coding-standard-metrics-review --base=<ref> [--head=<ref>] [--output=<dir>]

  --base    Target branch or commit used to calculate merge-base (required).
  --head    Current checked out commit (default: HEAD).
  --output  Review artifact directory (default: var/metrics-review).

TEXT);
            exit(0);
        }
        if (preg_match('/^--(base|head|output)=(.+)$/', $argument, $match) !== 1) {
            throw new InvalidArgumentException("Unknown or incomplete option: $argument");
        }
        $options[$match[1]] = $match[2];
    }
    if (!isset($options['base'])) {
        throw new InvalidArgumentException('Required option is missing: --base');
    }
    (new MetricsReviewPipeline(dirname(__DIR__), (string) getcwd()))->run(
        $options['base'],
        $options['head'] ?? 'HEAD',
        $options['output'] ?? 'var/metrics-review',
    );
} catch (Throwable $exception) {
    fwrite(STDERR, "coding-standard-metrics-review: {$exception->getMessage()}\n");
    exit(1);
}

#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloadPath = $GLOBALS['_composer_autoload_path'] ?? getcwd() . '/vendor/autoload.php';
if (!is_file($autoloadPath)) {
    $autoloadPath = dirname(__DIR__) . '/vendor/autoload.php';
}
require $autoloadPath;

use PhpParser\ParserFactory;
use PrikotovCodingStandard\Metrics\AstMetricsCollector;
use PrikotovCodingStandard\Metrics\ProjectMetricsCollector;

$options = getopt('', ['source::', 'project-root::', 'config::', 'output::']);
$source = isset($options['source']) && is_string($options['source']) ? rtrim($options['source'], '/') : null;
$projectRoot = is_string($options['project-root'] ?? null) ? $options['project-root'] : (string) getcwd();
$configPath = is_string($options['config'] ?? null) ? $options['config'] : $projectRoot . '/.coding-standard.php';
$output = $options['output'] ?? 'var/metrics/collector.json';

if ($source !== null && !is_dir($source)) {
    fwrite(STDERR, "metrics-collect: Source directory does not exist: $source\n");
    exit(1);
}

try {
    $parser = (new ParserFactory())->createForNewestSupportedVersion();
    if ($source !== null) {
        $report = (new AstMetricsCollector($parser, $source))->collect();
    } else {
        if (!is_file($configPath)) {
            throw new RuntimeException("Project configuration does not exist: $configPath");
        }
        $config = require $configPath;
        if (!is_array($config)) {
            throw new RuntimeException("Project configuration must return an array: $configPath");
        }
        $collector = new ProjectMetricsCollector($parser, $projectRoot, $config['metrics'] ?? []);
        $report = $collector->collect();
    }
    $directory = dirname($output);
    if (!is_dir($directory) && !mkdir($directory, 0777, true) && !is_dir($directory)) {
        throw new RuntimeException("Cannot create output directory: $directory");
    }
    $json = json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR);
    file_put_contents($output, $json . "\n");
    fwrite(STDOUT, "Metrics source report written to $output\n");
} catch (Throwable $exception) {
    fwrite(STDERR, "metrics-collect: {$exception->getMessage()}\n");
    exit(1);
}

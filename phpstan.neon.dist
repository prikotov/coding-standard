includes:
    - phpstan-baseline.neon
parameters:
    level: max
    paths:
        - src/
        - tests/
    excludePaths:
        - tests/fixtures/*
        - src/Metrics/*
        - tests/Metrics/*
    scanDirectories:
        - vendor/squizlabs/php_codesniffer/src
    reportUnmatchedIgnoredErrors: false

{
    "name": "prikotov/coding-standard",
    "description": "PHP CodeSniffer coding standard with custom sniffs",
    "type": "phpcodesniffer-standard",
    "license": "MIT",
    "keywords": ["phpcs", "coding-standard", "sniffs"],
    "authors": [
        {
            "name": "Dmitry Prikotov",
            "email": "prikotov@gmail.com"
        }
    ],
    "bin": ["bin/coding-standard-init", "bin/validate-md-links", "bin/validate-language", "bin/coding-standard-metrics", "bin/coding-standard-metrics-compare", "bin/coding-standard-metrics-review", "bin/coding-standard-di-check", "bin/coding-standard-verify", "bin/metrics-collect", "bin/metrics-scc", "bin/metrics-coverage", "bin/test-stats"],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "ext-simplexml": "*",
        "nikic/php-parser": "^5.8",
        "slevomat/coding-standard": "^8.0",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/yaml": "^7.2|^8.0"
    },
    "repositories": [
        {"type": "vcs", "url": "https://github.com/prikotov/todo-md"}
    ],
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "deptrac/deptrac": "^2.0",
        "php-code-archeology/php-code-archeology": "^2.11",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "prikotov/todo-md": "^0.0.10"
    },
    "autoload": {
        "psr-4": {
            "PrikotovCodingStandard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrikotovCodingStandard\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "deptrac/deptrac": "For using ServiceContractDependencyRule — custom Deptrac rule that enforces service contract boundaries",
        "phpstan/phpstan": "For static analysis — recommended replacement for PHPMD"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-code-archeology/php-code-archeology": true
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "sniff-test": "php bin/run-sniff-tests.php",
        "validate-docs": "php bin/validate-docs.php",
        "validate-md-links": "php bin/validate-md-links",
        "validate-language": "php bin/validate-language --strict",
        "validate-todo": "php vendor/bin/todo-md validate todo/*.todo.md todo/backlog/",
        "check": [
            "@test",
            "@sniff-test",
            "@validate-docs",
            "@validate-md-links",
            "@validate-language",
            "@validate-todo",
            "@phpstan",
            "phpcs src/"
        ],
        "coverage": "bin/metrics-coverage",
        "metrics-test-stats": "bin/test-stats --format=json --output var/metrics/test-stats.json"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        },
        "phpstan/extension-installer": {
            "extensions": [
                "phpstan-rules.neon"
            ]
        }
    },
    "archive": {
        "include": ["/bin/"]
    }
}
